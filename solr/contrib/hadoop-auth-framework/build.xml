<project name="solr-hadoop-auth-framework" default="default">

  <description>
    Hadoop Token Framework bridge for Solr delegation tokens.
    Enables YARN containers to store, renew, and cancel Solr delegation tokens
    via the standard Hadoop Credentials / Token API.
  </description>

  <import file="../contrib-build.xml"/>

  <path id="classpath">
    <path refid="solr.base.classpath"/>
    <fileset dir="lib" includes="*.jar" erroronmissingdir="false"/>
  </path>

  <path id="test.classpath">
    <path refid="solr.test.base.classpath"/>
    <pathelement path="${common-solr.dir}/build/solr-core/classes/test"/>
    <fileset dir="lib" includes="*.jar" erroronmissingdir="false"/>
    <fileset dir="${test.lib.dir}" includes="*.jar" erroronmissingdir="false"/>
  </path>

  <target name="compile-core" depends="solr-contrib-build.compile-core"/>

  <target name="compile-test" depends="compile-test-solr-core,compile-core,common-solr.compile-test"/>

</project>
